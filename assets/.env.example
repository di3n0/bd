# Black Duck connection. Store the real token only in .env or a secret manager.
BLACKDUCK_URL=https://blackduck.example.com
BLACKDUCK_API_TOKEN=replace-me
BLACKDUCK_PROJECT_GROUP=default-group
BLACKDUCK_API_TIMEOUT_SECONDS=300
BLACKDUCK_TRUST_CERT=false

# Optional outbound proxies used by the wrapper when connecting to Black Duck.
# Leave empty to disable. Optional credentials may use http://user:password@host:port.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local
HTTP_PROXY_USERNAME_HEADER=X-BlackDuck-Http-Proxy-Username
HTTP_PROXY_PASSWORD_HEADER=X-BlackDuck-Http-Proxy-Password
HTTPS_PROXY_USERNAME_HEADER=X-BlackDuck-Https-Proxy-Username
HTTPS_PROXY_PASSWORD_HEADER=X-BlackDuck-Https-Proxy-Password

# Exact HTTP endpoints exposed by the Kubernetes Services.
DETECT_SERVICE_URL=http://blackduck-detect.blackduck.svc.cluster.local/scan
SIGNATURE_SERVICE_URL=http://blackduck-signature.blackduck.svc.cluster.local/scan
# SIGMA_SERVICE_URL is accepted as a legacy alias for SIGNATURE_SERVICE_URL.
BDBA_SERVICE_URL=http://blackduck-bdba.blackduck.svc.cluster.local/scan
IMAGE_SERVICE_URL=http://blackduck-image.blackduck.svc.cluster.local/scan

# Optional status URL fallbacks. Prefer statusUrl returned by POST /scan.
# Supported placeholders: {requestId} and {operation}
DETECT_STATUS_URL_TEMPLATE=http://blackduck-detect.blackduck.svc.cluster.local/status/{requestId}
SIGNATURE_STATUS_URL_TEMPLATE=http://blackduck-signature.blackduck.svc.cluster.local/status/{requestId}
BDBA_STATUS_URL_TEMPLATE=http://blackduck-bdba.blackduck.svc.cluster.local/status/{requestId}
IMAGE_STATUS_URL_TEMPLATE=http://blackduck-image.blackduck.svc.cluster.local/status/{requestId}

# The wrapper service receives the Black Duck API token in this header.
BLACKDUCK_TOKEN_HEADER=X-BlackDuck-Api-Token

# Per high-level service timeout, in seconds.
SOURCE_TIMEOUT_SECONDS=1800
BINARY_TIMEOUT_SECONDS=1800
IMAGE_TIMEOUT_SECONDS=3600

# Maximum simultaneous high-level jobs. A source job invokes Detector and Signature.
SOURCE_MAX_CONCURRENCY=5
BINARY_MAX_CONCURRENCY=5
IMAGE_MAX_CONCURRENCY=8

# Status polling. STATUS_MAX_WAIT_SECONDS=0 means use the scan timeout.
STATUS_POLL_ENABLED=true
STATUS_POLL_INTERVAL_SECONDS=15
STATUS_HTTP_TIMEOUT_SECONDS=30
STATUS_MAX_WAIT_SECONDS=0
STATUS_SUCCESS_VALUES=COMPLETED,SUCCESS,SUCCEEDED,DONE
STATUS_FAILURE_VALUES=FAILED,ERROR,CANCELLED,CANCELED,TIMED_OUT
ALLOW_CROSS_HOST_STATUS_URL=false

# Profile defaults.
SOURCE_SCAN_DEPTH=5
BINARY_SCAN_DEPTH=1
IMAGE_SCAN_DEPTH=5
IMAGE_COMPONENT_SCOPE=source
IMAGE_DEEP_SCAN_DEPTH=100
IMAGE_DEEP_COMPONENT_SCOPE=all
SIGNATURE_SNIPPET_MODE=false

# Kubernetes Job Pod resources forwarded to the wrapper services.
SOURCE_POD_CPU_REQUEST=500m
SOURCE_POD_CPU_LIMIT=2
SOURCE_POD_MEMORY_REQUEST=1Gi
SOURCE_POD_MEMORY_LIMIT=4Gi

BINARY_POD_CPU_REQUEST=1
BINARY_POD_CPU_LIMIT=4
BINARY_POD_MEMORY_REQUEST=2Gi
BINARY_POD_MEMORY_LIMIT=8Gi

IMAGE_POD_CPU_REQUEST=2
IMAGE_POD_CPU_LIMIT=8
IMAGE_POD_MEMORY_REQUEST=4Gi
IMAGE_POD_MEMORY_LIMIT=16Gi

# Common Detect behavior forwarded to the wrapper services.
BLACKDUCK_SCAN_MODE=INTELLIGENT
DETECT_WAIT_FOR_RESULTS=true
DETECT_CLEANUP=true
DETECT_LOG_LEVEL=INFO

# Optional JSON object of extra Black Duck Detect properties.
# Example: {"detect.policy.check.fail.on.severities":"BLOCKER,CRITICAL"}
BLACKDUCK_EXTRA_PROPERTIES_JSON={}
